[Unit]
Description=COLDWIRE IPv4 SPA listener
Requires=coldwire-access-firewall.service
After=coldwire-access-firewall.service network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/coldwire-access/spa.env
ExecStart=/opt/coldwire-access/coldwire-spa --bind ${CW_SPA_BIND} --port ${CW_SPA_PORT} --keys /etc/coldwire-access/spa-keys.json
Restart=on-failure
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_INET AF_NETLINK AF_UNIX

[Install]
WantedBy=multi-user.target
