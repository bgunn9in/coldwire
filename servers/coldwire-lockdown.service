[Unit]
Description=COLDWIRE WAN firewall and rollback on boot
DefaultDependencies=no
RequiresMountsFor=/etc/coldwire-lockdown /opt/coldwire-lockdown /usr
After=local-fs.target nftables.service
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/coldwire-lockdown/stage-lockdown.sh load
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
