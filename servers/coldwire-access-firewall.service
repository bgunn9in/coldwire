[Unit]
Description=COLDWIRE WAN access policy
After=nftables.service
Before=coldwire-spa.service blackice-relay.service awg-relay-kit-exit.service docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/coldwire-access/stage-access.sh load
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
