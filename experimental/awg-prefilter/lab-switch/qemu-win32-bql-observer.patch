+typedef struct CW47Hold {
+    int64_t request_ns, acquire_ns, release_ns;
+    DWORD previous_owner;
+    const char *file;
+    int line;
+} CW47Hold;
+
+static QemuMutex *cw47_bql;
+static DWORD cw47_owner;
+static __thread CW47Hold cw47_hold;
+
+void cw47_register_bql(QemuMutex *mutex);
+void cw47_register_bql(QemuMutex *mutex)
+{
+    qatomic_set(&cw47_bql, mutex);
+    fprintf(stderr, "CW47 main pid=%lu tid=%lu\n",
+            GetCurrentProcessId(), GetCurrentThreadId());
+}
+
+static void cw47_acquired(int64_t request, DWORD previous, const char *file, int line)
+{
+    cw47_hold = (CW47Hold){request, qemu_clock_get_ns(QEMU_CLOCK_REALTIME),
+                           0, previous, file, line};
+    qatomic_set(&cw47_owner, GetCurrentThreadId());
+}
+
+static CW47Hold cw47_releasing(void)
+{
+    CW47Hold hold = cw47_hold;
+    hold.release_ns = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    qatomic_set(&cw47_owner, 0);
+    return hold;
+}
+
+static void cw47_log_hold(CW47Hold hold)
+{
+    if (hold.acquire_ns && (hold.release_ns - hold.acquire_ns >= 5000000 ||
+                             (hold.request_ns && hold.acquire_ns - hold.request_ns >= 5000000))) {
+        fprintf(stderr, "CW47 bql tid=%lu request=%" PRId64 " acquired=%" PRId64
+                " release=%" PRId64 " previous_owner=%lu file=%s line=%d\n",
+                GetCurrentThreadId(), hold.request_ns, hold.acquire_ns, hold.release_ns,
+                hold.previous_owner, hold.file, hold.line);
+    }
+}
