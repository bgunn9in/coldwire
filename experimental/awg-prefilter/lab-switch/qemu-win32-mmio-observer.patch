+#ifdef CONFIG_WIN32
+static void cw48_mmio(const MemoryRegion *mr, hwaddr addr, hwaddr offset,
+                      hwaddr size, char direction, int64_t request_ns,
+                      int64_t prepared_ns, int64_t done_ns)
+{
+    Object *owner;
+
+    if (done_ns - prepared_ns < 1000000 &&
+        prepared_ns - request_ns < 1000000) {
+        return;
+    }
+    owner = memory_region_owner(mr);
+    fprintf(stderr, "CW48 mmio tid=%lu request=%" PRId64
+            " prepared=%" PRId64 " done=%" PRId64
+            " addr=0x%" HWADDR_PRIX " offset=0x%" HWADDR_PRIX
+            " width=%" HWADDR_PRIu " dir=%c region=\"%s\" owner=\"%s\"\n",
+            GetCurrentThreadId(), request_ns, prepared_ns, done_ns, addr,
+            offset, size, direction, memory_region_name(mr),
+            owner ? object_get_typename(owner) : "<none>");
+}
+#endif
