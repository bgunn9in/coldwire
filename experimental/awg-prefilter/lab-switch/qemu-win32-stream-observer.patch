diff --git a/net/stream_data.c b/net/stream_data.c
--- a/net/stream_data.c
+++ b/net/stream_data.c
@@ -13,8 +13,69 @@
 #include "io/channel.h"
 #include "io/net-listener.h"
 #include "qemu/sockets.h"
+#include "qemu/timer.h"
+#include "qemu/main-loop.h"
+#include "qemu/atomic.h"

 #include "stream_data.h"
+
+#ifdef CONFIG_WIN32
+static int net_stream_lab_heartbeat(void *opaque)
+{
+    NetStreamData *d = opaque;
+    qatomic_set(&d->lab_poll_ns, qemu_clock_get_ns(QEMU_CLOCK_REALTIME));
+    return 0;
+}
+
+static void *net_stream_lab_receiver(void *opaque)
+{
+    NetStreamData *d = opaque;
+    int64_t next_heartbeat = 0;
+    while (!qatomic_read(&d->lab_stop)) {
+        int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+        int64_t last_read = qatomic_read(&d->lab_last_read);
+        if (now >= next_heartbeat || (last_read && now - last_read >= 50000000)) {
+            unsigned long available = 0;
+            int status = ioctlsocket(d->lab_fd, FIONREAD, &available);
+            int error = status ? errno : 0;
+            int64_t poll = qatomic_read(&d->lab_poll_ns);
+            int64_t pause = qatomic_read(&d->lab_pause_start);
+            fprintf(d->lab_log, "CW45 rx now=%" PRId64 " last_read=%" PRId64
+                    " poll=%" PRId64 " pause=%" PRId64 " available=%lu error=%d\n",
+                    now, last_read, poll, pause, available, error);
+            fflush(d->lab_log);
+            next_heartbeat = now + 1000000000;
+        }
+        g_usleep(50000);
+    }
+    return NULL;
+}
+#endif
+
+void net_stream_lab_probe(NetStreamData *d, bool enable)
+{
+#ifdef CONFIG_WIN32
+    const char *path = getenv("CW45_STREAM_RX_LOG");
+    if (enable && !d->lab_log && !strcmp(d->nc.name, "lab") && path) {
+        d->lab_log = fopen(path, "wb");
+        if (!d->lab_log) {
+            perror("CW45 RX log");
+            return;
+        }
+        d->lab_fd = QIO_CHANNEL_SOCKET(d->ioc)->fd;
+        qatomic_set(&d->lab_stop, false);
+        qemu_add_polling_cb(net_stream_lab_heartbeat, d);
+        qemu_thread_create(&d->lab_thread, "cw45-rx",
+                           net_stream_lab_receiver, d, QEMU_THREAD_JOINABLE);
+    } else if (!enable && d->lab_log) {
+        qemu_del_polling_cb(net_stream_lab_heartbeat, d);
+        qatomic_set(&d->lab_stop, true);
+        qemu_thread_join(&d->lab_thread);
+        fclose(d->lab_log);
+        d->lab_log = NULL;
+    }
+#endif
+}

