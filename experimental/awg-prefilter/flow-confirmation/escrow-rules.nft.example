# SPDX-License-Identifier: MIT
# Disposable IPv4 lab only: queues 101 and 102 must be alive; nf_conntrack_acct=1 required.
# Split 6000/s + 2048 burst across bulk (4976/1024), discovery (960/960), probes (64/64).
table ip awg_kernel_guard_lab {
    set unknown_sources {
        type ipv4_addr
        flags dynamic,timeout
        timeout 5s
        gc-interval 1s
        size 4096
    }
    set discovery_sources {
        type ipv4_addr
        flags dynamic,timeout
        timeout 5s
        gc-interval 1s
        size 4096
    }
    set trusted {
        typeof ip saddr . udp sport . ct id
        flags timeout
        timeout 10s
        gc-interval 1s
        size 4096
    }
    set handshake_sources {
        type ipv4_addr
        flags dynamic,timeout
        timeout 5s
        gc-interval 1s
        size 4096
    }
    chain handshake_aggregate {
        limit rate over 100/second burst 16 packets counter drop
        counter return
    }
    chain handshake_guard {
        update @handshake_sources { ip saddr limit rate 20/second burst 8 packets } counter goto handshake_aggregate
        counter drop
    }
    chain aggregate {
        limit rate over 4976/second burst 1024 packets counter goto hold
        counter return
    }
    chain unconfirmed {
        # The optional bridge supplement replaces this chain atomically.
        counter queue to numgen inc mod 2 offset 101
    }
    chain hold {
        ct status confirmed counter queue to numgen inc mod 2 offset 101
        goto unconfirmed
    }
    chain guard {
        update @unknown_sources { ip saddr limit rate 1500/second burst 4096 packets } counter goto aggregate
        # Excess remains untrusted while held; no listener means drop.
        counter goto hold
    }
    chain trusted_flow {
        ip saddr 192.168.76.40 counter comment "trusted_noise"
        counter return comment "trusted_total"
    }
    chain early {
        type filter hook prerouting priority -150; policy accept;
        iifname "enp0s3" ip daddr 192.168.76.10 ip saddr 192.168.76.20 udp sport 32497 ct direction reply return
        iifname "enp0s3" ip daddr 192.168.76.10 udp dport 32497 meta mark set meta mark & 0x81ffffff
        iifname "enp0s3" ip daddr 192.168.76.10 udp dport 32497 ip saddr . udp sport . ct id @trusted meta mark set meta mark | 0x10000000 goto trusted_flow
        # Reused NAT tuples can retain conntrack; discovery must not require its first packet.
        iifname "enp0s3" ip daddr 192.168.76.10 udp dport 32497 update @discovery_sources { ip saddr limit rate 32/second burst 256 packets } limit rate 960/second burst 960 packets counter return comment "discovery_sample"
        iifname "enp0s3" ip daddr 192.168.76.10 udp dport 32497 jump guard
    }
    chain escrow_recheck {
        meta mark set meta mark & 0xf7ffffff
        ip saddr . udp sport . ct id @trusted meta mark set meta mark | 0x10000000 counter return comment "escrow_current"
        counter drop comment "escrow_stale"
    }
    chain escrow_validate {
        type filter hook prerouting priority -146; policy accept;
        meta mark & 0x08000000 != 0 jump escrow_recheck
        meta mark & 0x04000000 != 0 jump probe_recheck
    }
    chain probe_recheck {
        meta mark set meta mark & 0xfbffffff
        limit rate over 64/second burst 64 packets counter drop
        counter return comment "escrow_probe"
    }
    chain queued {
        type filter hook prerouting priority -140; policy accept;
        iifname "enp0s3" ip daddr 192.168.76.10 ip saddr 192.168.76.20 udp sport 32497 ct direction reply return
        iifname "enp0s3" ip daddr 192.168.76.10 udp dport 32497 meta mark & 0x02000000 != 0 counter return comment "late_deferred"
        iifname "enp0s3" ip daddr 192.168.76.10 udp dport 32497 meta mark & 0x10000000 != 0 return
        iifname "enp0s3" ip daddr 192.168.76.10 udp dport 32497 queue num 100
    }
    chain classified_handshakes {
        type filter hook prerouting priority -138; policy accept;
        iifname "enp0s3" ip daddr 192.168.76.10 ip saddr 192.168.76.20 udp sport 32497 ct direction reply return
        iifname "enp0s3" ip daddr 192.168.76.10 udp dport 32497 meta mark & 0x02000000 != 0 return
        iifname "enp0s3" ip daddr 192.168.76.10 udp dport 32497 meta mark & 0x10000000 != 0 return
        # An older filter without classification must fail closed.
        iifname "enp0s3" ip daddr 192.168.76.10 udp dport 32497 meta mark & 0x40000000 == 0 counter drop
        iifname "enp0s3" ip daddr 192.168.76.10 udp dport 32497 meta mark & 0x20000000 != 0 jump handshake_guard
    }
}
