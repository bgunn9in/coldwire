# SPDX-License-Identifier: MIT
# Optional routed-bridge lab path. Physical enp0s3 must be a port of cw34br;
# the entry's lab IPv4 address belongs to cw34br. No production installer.
# Load with the late-hold rule changes, before enabling late_escrow in A.
table bridge awg_escrow_bridge_lab {
    set trusted {
        typeof ct original ip saddr . ct original proto-src . ct id
        flags timeout
        timeout 10s
        gc-interval 1s
        size 4096
    }
    chain held {
        type filter hook postrouting priority 300; policy accept;
        meta mark & 0x02000000 == 0 return
        oifname "enp0s3" ether type ip ip saddr 192.168.76.10 ip daddr 192.168.76.20 udp dport 32497 ct status confirmed counter queue to numgen inc mod 2 offset 101
        counter drop comment "late_unconfirmed"
    }
    chain validate {
        type filter hook postrouting priority 301; policy accept;
        meta mark & 0x02000000 == 0 return
        ct status & 0x200 != 0 counter drop comment "late_dying"
        meta mark & 0x04000000 != 0 goto probe
        meta mark & 0x08000000 != 0 ct status confirmed ct original ip saddr . ct original proto-src . ct id @trusted meta mark set meta mark & 0xe1ffffff counter return comment "late_current"
        counter drop comment "late_stale"
    }
    chain probe {
        # C also shares one 64/s bucket across prerouting and bridge probes.
        limit rate over 64/second burst 64 packets counter drop
        meta mark set meta mark & 0x85ffffff counter return comment "late_probe"
    }
    chain probe_classify {
        type filter hook postrouting priority 302; policy accept;
        meta mark & 0x04000000 != 0 counter queue num 100 comment "late_probe_classify"
    }
    chain probe_validate {
        type filter hook postrouting priority 303; policy accept;
        meta mark & 0x04000000 == 0 return
        meta mark & 0x40000000 == 0 counter drop
        # Only transport can produce the fresh proof; do not add handshake budget.
        meta mark & 0x20000000 != 0 counter drop comment "late_control_probe_drop"
        meta mark set meta mark & 0x81ffffff counter return comment "late_probe_pass"
    }
}

# Keep this switch and bridge-table creation in one nft transaction.
flush chain ip awg_kernel_guard_lab unconfirmed
add rule ip awg_kernel_guard_lab unconfirmed meta mark set meta mark | 0x02000000 counter return
