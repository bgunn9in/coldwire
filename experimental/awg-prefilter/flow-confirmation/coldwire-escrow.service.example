# SPDX-License-Identifier: MIT
[Unit]
Description=COLDWIRE experimental packet escrow (lab only)
ConditionHost=kit-entry
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/root/flow-confirmation/escrow --vm-test
Restart=on-failure
RestartSec=200ms
RuntimeDirectory=coldwire-escrow
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
UMask=0077
MemoryMax=96M
TimeoutStopSec=3
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
