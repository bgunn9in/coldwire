# SPDX-License-Identifier: MIT
[Unit]
Description=COLDWIRE experimental entry proof helper (lab only)
ConditionHost=kit-entry
Requires=coldwire-escrow.service
After=network-online.target coldwire-escrow.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/flow-confirmation/agent.py --vm-test entry /root/flow-confirmation/config.json
Restart=on-failure
RestartSec=200ms
UMask=0077
MemoryMax=64M
TimeoutStopSec=3
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
