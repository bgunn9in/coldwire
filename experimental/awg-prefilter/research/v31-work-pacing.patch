+// Charge the whole selected batch, including pending snapshots larger than the ring.
+func (cache *coldwireReturnCache) paceReplay(now time.Time, buffers [][]byte) {
+	size := 0
+	for _, buffer := range buffers {
+		size += len(buffer)
+	}
+	const fullBatch = 250 * time.Millisecond
+	packets := (time.Duration(len(buffers))*fullBatch + coldwireReplaySlots - 1) / coldwireReplaySlots
+	bytes := (time.Duration(size)*fullBatch + coldwirePendingBytes - 1) / coldwirePendingBytes
+	cache.replayAfter = now.Add(max(coldwirePeerReplayInterval, packets, bytes))
+}
