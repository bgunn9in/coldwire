diff --git a/experimental/awg-prefilter/flow-confirmation/coldwire_return_pacing_linux_test.go b/experimental/awg-prefilter/flow-confirmation/coldwire_return_pacing_linux_test.go
new file mode 100644
--- /dev/null
+++ b/experimental/awg-prefilter/flow-confirmation/coldwire_return_pacing_linux_test.go
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: MIT
+package device
+
+import (
+	"testing"
+	"time"
+)
+
+func TestColdwireSmallRecoveryDoesNotWaitForFullBatch(t *testing.T) {
+	cache := new(coldwireReturnCache)
+	now := time.Now()
+	id := [32]byte{1}
+	cache.remember(coldwireReturnPacket{peer: id, birth: now, index: 1, sent: now, payload: []byte("ciphertext")})
+	buffers, through := cache.selectReplies(id, now, 1, now)
+	cache.holdReplies(id, now, 1, "first", now, through, buffers)
+	cache.retargetPending(id, now, 1, "latest", now.Add(40*time.Millisecond))
+	if len(cache.takePending(id, now, 1, "latest", now.Add(49*time.Millisecond))) != 0 {
+		t.Fatal("small recovery bypassed the minimum interval")
+	}
+	if len(cache.takePending(id, now, 1, "latest", now.Add(60*time.Millisecond))) != 1 {
+		t.Fatal("a small recovery still waits for a full-batch cooldown")
+	}
+	if len(cache.takePending(id, now, 1, "latest", now.Add(120*time.Millisecond))) != 0 {
+		t.Fatal("stationary traffic armed another attempt")
+	}
+}
+
+func TestColdwireReplayPacingChargesGlobalPacketAndByteWork(t *testing.T) {
+	now := time.Now()
+	for _, test := range []struct {
+		name        string
+		count, size int
+		want        time.Duration
+	}{
+		{"small", 10, 100, 50 * time.Millisecond},
+		{"packet-bound", 8192, 100, 250 * time.Millisecond},
+		{"ring-byte-bound", 128, 65536, 125 * time.Millisecond},
+		{"pending-byte-bound", 256, 65536, 250 * time.Millisecond},
+		{"rounded-byte-charge", 3000, 1280, 91552735 * time.Nanosecond},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			cache := new(coldwireReturnCache)
+			buffers := make([][]byte, test.count)
+			packet := make([]byte, test.size)
+			for i := range buffers {
+				buffers[i] = packet
+			}
+			cache.paceReplay(now, buffers)
+			if got := cache.replayAfter.Sub(now); got != test.want {
+				t.Fatalf("work interval = %v, want %v", got, test.want)
+			}
+			other := [32]byte{2}
+			cache.remember(coldwireReturnPacket{peer: other, birth: now, index: 1, sent: now, payload: []byte("other peer")})
+			cache.deferReplies(other, now, 1, "current", now, now)
+			if len(cache.takePending(other, now, 1, "current", now.Add(test.want-time.Nanosecond))) != 0 {
+				t.Fatal("another peer bypassed the global work charge")
+			}
+			if len(cache.takePending(other, now, 1, "current", now.Add(test.want))) != 1 {
+				t.Fatal("eligible peer remained blocked after the work interval")
+			}
+		})
+	}
+}
