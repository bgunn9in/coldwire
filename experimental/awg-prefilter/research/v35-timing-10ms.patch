@@ -0,0 +1,31 @@
+package device
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestColdwireLabTimingMeasuresDueAtAcceptance(t *testing.T) {
+	cache := new(coldwireReturnCache)
+	now := time.Now()
+	id := [32]byte{1}
+	record := ""
+	peer := new(Peer)
+	peer.device = new(Device)
+	peer.device.log = &Logger{Verbosef: func(f string, a ...any) { record = fmt.Sprintf(f, a...) }}
+	cache.remember(coldwireReturnPacket{peer: id, birth: now, index: 1, sent: now, payload: []byte("ciphertext")})
+	cache.lastReplay = now
+	cache.deferReplies(id, now, 1, "current", now, now.Add(250*time.Millisecond))
+	cache.watchPending(id, peer)
+	if len(cache.takePending(id, now, 1, "current", now.Add(249*time.Millisecond))) != 0 || record != "" {
+		t.Fatal("premature retry emitted an acceptance timing")
+	}
+	if len(cache.takePending(id, now, 1, "current", now.Add(299*time.Millisecond))) != 1 {
+		t.Fatal("eligible retry absent")
+	}
+	if !strings.Contains(record, "due_late_ns=49000000 since_global_ns=299000000") {
+		t.Fatal("wrong same-clock due/global timing", record)
+	}
+}
