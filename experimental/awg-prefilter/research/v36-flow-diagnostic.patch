@@ -0,0 +1,22 @@
+import atexit,collections,json,signal,time
+from pathlib import Path
+events=collections.deque(maxlen=16384);dropped=0;role='unset';before=None
+def ctstats():
+ try:
+  lines=Path('/proc/net/stat/nf_conntrack').read_text().splitlines();header=lines[0].split();rows=[dict(zip(header,[int(v,16) for v in line.split()])) for line in lines[1:]]
+  return {key:(rows[0][key] if key=='entries' else sum(row[key] for row in rows)) for key in header}
+ except (OSError,ValueError,IndexError,KeyError):return {'unavailable':True}
+def record(stage,flow=None,**fields):
+ global dropped
+ if flow is not None and flow['source'] not in ('192.168.76.30','192.168.76.31'):return
+ if len(events)==events.maxlen:dropped+=1
+ item={'stage':stage,'mono_ns':time.monotonic_ns(),'wall_ns':time.time_ns(),**fields}
+ if flow is not None:item['flow']=flow
+ events.append(item)
+def dump(*_):
+ if role=='unset':return
+ target=Path('/root/flow-confirmation/trace32-'+role+'.json')
+ target.write_text(json.dumps({'role':role,'capacity':events.maxlen,'dropped':dropped,'events':list(events),'conntrack_before':before,'conntrack_after':ctstats()})+'\n')
+def start(name):
+ global role,before
+ role=name;before=ctstats();atexit.register(dump);signal.signal(signal.SIGUSR1,dump)
