# Disposable IPv4 lab only. Calibrate these rates against clean traffic first.
define wan = "enp0s3"
define entry = 192.168.76.10
define backend = 192.168.76.20
define entry_port = 32497
define backend_port = 32497

table ip awg_kernel_guard_lab {
    set flows {
        type ipv4_addr . inet_service
        flags dynamic,timeout
        timeout 5s
        gc-interval 1s
        size 4096
    }
    chain aggregate {
        limit rate over 50000/second burst 5000 packets counter drop
        counter return
    }
    chain guard {
        update @flows { ip saddr . udp sport limit rate 35000/second burst 3500 packets } counter goto aggregate
        # Allocation failure or an exhausted flow bucket reaches this rule.
        counter drop
    }
    chain early {
        type filter hook prerouting priority -310; policy accept;
        iifname $wan ip daddr $entry ip saddr $backend udp sport $backend_port return
        iifname $wan ip daddr $entry udp dport $entry_port jump guard
    }
    chain backend_original {
        type filter hook prerouting priority -160; policy accept;
        iifname $wan ip daddr $entry ip saddr $backend udp sport $backend_port udp dport $entry_port ct direction original jump guard
    }
}
